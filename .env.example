# Telegram
BOT_TOKEN=
API_ID=
API_HASH=
SESSION_STRING=
BOT_USERNAME=
DEVELOPER_USERNAME=thevisionaryoffc
DEVELOPER_NAME=Cinema HUB OG Developer
GREETING_TIMEZONE=Asia/Kolkata
START_IMAGE_URLS=
ADMIN_IDS=
# Comma-separated numeric Telegram user IDs. Use /id in the bot to see yours.

# MongoDB
MONGO_URI=
DB_NAME=autofilter
# Legacy aliases accepted: DATABASE_URI= and DATABASE_NAME=

# Channels / group
DATABASE_CHANNEL_ID=
# V4 Request Group is hard-locked to @moviesearchoffc. The following legacy values are ignored.
REQUEST_GROUP_ID=
REQUEST_GROUP_USERNAME=
# Legacy alias accepted: BIN_CHANNEL=

# Force subscribe. Entries are paired in order. V4 fails closed: bad/missing configured channels stop startup rather than disabling F-Sub.
# Public example: @publicchannel
# Private example: -1001234567890
FSUB_CHANNELS=
FSUB_INVITE_LINKS=

# Softurl shortener
# Keep the API token private in Render Environment Variables.
SOFTURL_API=
SOFTURL_BASE_URL=https://softurl.in/api

# Gates / timing
REQUIRE_FSUB=true
REQUIRE_SHORTLINK=true
# Legacy alias: IS_VERIFY=true
SHORTLINK_TTL_SECONDS=1800
DELETE_AFTER_SECONDS=300
# Bot search-result messages auto-delete 10 minutes after first appearing.
SEARCH_RESULT_DELETE_AFTER_SECONDS=600

# Indexing / search
INDEX_ON_START=false
AUTO_INDEX_NEW_POSTS=true
SEARCH_PAGE_SIZE=8
# Deprecated compatibility setting. Search is no longer capped by this value.
MAX_SEARCH_RESULTS=
SEND_ALL_LIMIT=1000
INDEX_BATCH_SIZE=250
CAPTION_WORKER_INTERVAL_SECONDS=2
CAPTION_EDIT_MIN_INTERVAL_SECONDS=1.1
SEARCH_DB_CONCURRENCY=8

# Optional logging
LOG_CHAT_ID=

# Telegram network resilience
TELEGRAM_READ_TIMEOUT=45
TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_WRITE_TIMEOUT=45
TELEGRAM_POOL_TIMEOUT=30
STARTUP_RETRY_DELAY=5

EXPIRY_NOTICE="⚠️ ᴛʜɪꜱ ᴍᴏᴠɪᴇ ꜰɪʟᴇ/ᴠɪᴅᴇᴏ ᴡɪʟʟ ʙᴇ ᴅᴇʟᴇᴛᴇᴅ ɪɴ 5 ᴍɪɴᴜᴛᴇꜱ\n\nᴘʟᴇᴀꜱᴇ ꜰᴏʀᴡᴀʀᴅ ᴛʜɪꜱ ꜰɪʟᴇ ᴛᴏ ꜱᴏᴍᴇᴡʜᴇʀᴇ ᴇʟꜱᴇ & ꜱᴛᴀʀᴛ ᴅᴏᴡɴʟᴏᴀᴅɪɴɢ ᴛʜᴇʀᴇ"
# Legacy aliases (optional; use the new names above for a fresh deployment)
DATABASE_URI=
DATABASE_NAME=
ADMINS=
BIN_CHANNEL=
IS_VERIFY=
# Render supplies PORT automatically; do not normally set it manually.
# PORT=10000

# Authorized/public-domain automatic ingestion (Internet Archive)
# IMPORTANT: keep disabled until you have verified the source items/licenses.
IA_INGEST_ENABLED=false
IA_INITIAL_BACKFILL=false
IA_RETRY_SKIPPED=false
IA_SCAN_INTERVAL_SECONDS=1800
IA_BATCH_SIZE=5
IA_INITIAL_PAGES=5
IA_SCAN_PAGES=10
IA_INITIAL_LIMIT=100
IA_PAGE_SIZE=50
IA_MAX_FILE_MB=1800
IA_HTTP_TIMEOUT=120
# Default query targets movie items advertising public-domain or non-NC
# Creative Commons licenses. You can narrow it to a collection you control.
IA_QUERY=mediatype:movies

# Premium subscription / payment screenshot workflow
PAYMENT_BOT_TOKEN=
PAYMENT_BOT_USERNAME=visionaryowner_bot
PAYMENT_BOT_FORCE_POLLING=true
PREMIUM_MEMBER_TAG=PREMIUM
PREMIUM_QR_URL=https://t.me/+7_i3pMzJBTFlZTQ1

# Separate browser streaming service
STREAM_BASE_URL=
STREAM_SIGNING_SECRET=
STREAM_TOKEN_TTL_SECONDS=1800

# Browser player branding
STREAM_POWERED_BY=Cinema HUB OG
STREAM_SERVICE_BY=The Visionary Team
STREAM_CACHE_MAX_AGE_SECONDS=21600

# Search concurrency
# Optional public logo URL; leave blank to fetch the database channel profile photo
STREAM_LOGO_URL=
# Free Render: keep this at 1
STREAM_TRANSCODE_CONCURRENCY=1
STREAM_CHUNK_SIZE=1048576
HLS_SEGMENT_SECONDS=6

STREAM_MEDIA_CONCURRENCY=6

# Single-step free verification (Softurl)
# Keep the shortener token secret; never include it in logs or source control.
VERIFICATION_SESSION_TTL_SECONDS=1800
VERIFICATION_ACCESS_TTL_SECONDS=21600
START_DELAY_SECONDS=2.5

# Referral reward policy: one day is credited only after a new referred user completes F-Sub/verification and receives their first file.
